{
  "name": "quan-ly-csdg",
  "main": "./src/worker.ts",
  // Mỗi phút một lượt: làm các việc đã đến giờ của doanh nghiệp vận hành thử (src/lib/sim.ts)
  "triggers": { "crons": ["* * * * *"] },
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "d1_databases": [
    { "binding": "DB", "database_name": "csdg", "database_id": "52bb15f4-438f-4d06-95a3-33a17bcbda8e", "migrations_dir": "migrations" }
  ]
}
