{
  "name": "quan-ly-csdg",
  "main": "./src/worker.ts",
  // Đồng hồ của doanh nghiệp vận hành thử: một Durable Object tự hẹn giờ đến việc kế tiếp (src/worker.ts, src/lib/sim.ts)
  "durable_objects": { "bindings": [{ "name": "SIM", "class_name": "SimClock" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["SimClock"] }],
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "d1_databases": [
    { "binding": "DB", "database_name": "csdg", "database_id": "52bb15f4-438f-4d06-95a3-33a17bcbda8e", "migrations_dir": "migrations" }
  ]
}
