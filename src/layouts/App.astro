---
import { LINES } from '../lib/fmt';
import { ROLES } from '../lib/perm';
const { title, active = '' } = Astro.props;
const { user, tenant, role, can, procs } = Astro.locals;
const nAct = procs.filter((p) => p.active).length;
const nav: [string, string, string, boolean][] = [
  ['', 'Bảng điều hành', '/app', true],
  ['Nhập hàng', 'Phiếu cân nhập', '/app/can', can('v.can')],
  ['Sản xuất', 'Quy trình', '/app/quy-trinh', true],
  ['', 'Lệnh công đoạn', '/app/cong-doan', can('v.cd')],
  ['Kho', 'Tồn kho theo lô', '/app/kho', true],
  ['', 'Sổ kho: nhập, xuất, tồn', '/app/so-kho', true],
  ['', 'Kiểm kê, điều chỉnh', '/app/dieu-chinh', can('stock') || can('report')],
  ['Bán hàng', 'Đơn hàng', '/app/don-hang', can('v.dh')],
  ['Giám sát', 'Truy xuất lô', '/app/truy-xuat', true],
  ['', 'Giá thành, hao hụt', '/app/bao-cao', can('fin')],
  ['', 'Đối soát số liệu', '/app/doi-soat', can('report') || can('stock')],
  ['', 'Nhật ký thay đổi', '/app/nhat-ky', can('report') || can('void') || can('members')],
  ['Thiết lập', 'Đối tác', '/app/doi-tac', can('catalog')],
  ['', 'Mặt hàng', '/app/mat-hang', can('catalog')],
  ['', 'Thành viên, cài đặt', '/app/thanh-vien', can('members')],
];
---
<!doctype html>
<html lang="vi">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="robots" content="noindex" />
<title>{title} · {tenant.name}</title>
<link rel="stylesheet" href="/app.css" />
</head>
<body>
<div class="shell">
  <aside class="side" id="side">
    <button class="menu-btn" onclick="document.getElementById('side').classList.toggle('open')">Menu</button>
    <div class="brand">{tenant.name}</div>
    <div class="tn">{nAct ? `${nAct} quy trình` : LINES[tenant.lines]}{tenant.is_demo ? ' · dữ liệu mẫu' : ''}{tenant.status === 'locked' ? ' · đang khóa' : ''}</div>
    <nav>
      {nav.filter((n) => n[3]).map(([grp, name, href]) => (
        <>{grp && <div class="grp">{grp}</div>}<a href={href} class={active === href ? 'on' : ''}>{name}</a></>
      ))}
      <div class="grp">Khác</div>
      <a href="/huong-dan" target="_blank">Hướng dẫn sử dụng</a>
      <a href="/chon">Đổi doanh nghiệp</a>
      {user.is_sysadmin ? <a href="/admin">Quản trị hệ thống</a> : null}
      <div class="me">{user.name || user.email}<br />{ROLES[role]?.name}<br />
        <form method="post" action="/dang-xuat"><button>Đăng xuất</button></form></div>
    </nav>
  </aside>
  <main class="main"><slot /></main>
</div>
</body>
</html>
