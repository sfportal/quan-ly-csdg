---
import App from '../../../layouts/App.astro';
import { all, run, today } from '../../../lib/db';
import { createTicket, Bad } from '../../../lib/domain';
import { SOURCE, toG, toD } from '../../../lib/fmt';
const { tenant: t, user, can } = Astro.locals;
if (!can('weigh')) return Astro.redirect('/app/can');
const money = can('money');
const partners = await all<any>(`SELECT * FROM partners WHERE tenant_id=? AND kind='supplier' AND active=1 ORDER BY sub, name`, t.id);
const items = await all<any>(`SELECT * FROM items WHERE tenant_id=? AND kind='NL' AND active=1 ORDER BY sort, code`, t.id);
let err = '';
const N = 20;
let f: FormData | null = null;
if (Astro.request.method === 'POST') {
  f = await Astro.request.formData();
  const g = (k: string) => String(f!.get(k) || '').trim();
  try {
    const lines = [];
    for (let i = 0; i < N; i++) {
      const it = items.find((x) => x.id === g(`item${i}`));
      if (!it) continue;
      lines.push({ item_id: it.id, gross_g: toG(g(`gross${i}`)), tare_g: toG(g(`tare${i}`)), deduct_g: toG(g(`ded${i}`)), price: money ? toD(g(`price${i}`)) : it.price });
    }
    const r = await createTicket(t, user.id, { date: g('date') || today(), partner_id: g('partner'), vehicle: g('vehicle'), pay_method: g('pay'), note: g('note'),
      doc_invoice: !!f.get('doc_invoice'), doc_list: !!f.get('doc_list'), doc_contract: !!f.get('doc_contract'), lines });
    if (money) for (const l of lines) if (l.price > 0 && l.gross_g > 0) await run('UPDATE items SET price=? WHERE id=? AND tenant_id=?', l.price, l.item_id, t.id);
    return Astro.redirect(`/app/can/${r.id}?new=1`);
  } catch (e) { if (e instanceof Bad) err = e.message; else throw e; }
}
const v = (k: string, d = '') => (f ? String(f.get(k) || '') : d);
---
<App title="Lập phiếu cân" active="/app/can">
  <div class="head"><div><h1>Lập phiếu cân nhập</h1><div class="mut sm">Ô nền xanh là hệ thống điền sẵn, sửa được khi cần. Người nhập chỉ cần chọn nhà cung cấp và gõ số cân.</div></div></div>
  {err && <div class="note err">{err}</div>}
  {!partners.length && <div class="note warn">Chưa có nhà cung cấp. <a href="/app/doi-tac">Thêm nhà cung cấp</a> trước khi lập phiếu.</div>}
  <form method="post" id="fm">
    <div class="card">
      <div class="row">
        <div class="f"><label>Nhà cung cấp</label><select name="partner" id="partner" required>
          <option value="">Chọn...</option>
          {Object.entries(SOURCE).map(([k, n]) => <optgroup label={n}>{partners.filter((p) => p.sub === k).map((p) => <option value={p.id} data-sub={p.sub} data-area={p.area_code} selected={v('partner') === p.id}>{p.name}</option>)}</optgroup>)}
        </select></div>
        <div class="f"><label>Ngày cân</label><input type="date" name="date" class="auto" value={v('date', today())} /></div>
        <div class="f"><label>Biển số xe</label><input name="vehicle" value={v('vehicle')} /></div>
        <div class="f" id="payf"><label>Hình thức thanh toán</label><select name="pay" class="auto"><option value="bank">Chuyển khoản</option><option value="cash" selected={v('pay') === 'cash'}>Tiền mặt</option></select></div>
      </div>
      <div id="src" class="note info" style="display:none"></div>
      <style>#wt.simple .dx{display:none}</style>
      <label class="chk" style="margin:10px 0 6px"><input type="checkbox" id="dxon" /> Có trừ sọt, xe hoặc trừ trái hư dập</label>
      <div class="mut sm" id="dxhelp" style="margin-bottom:8px"></div>
      <div data-rows><div class="tw"><table id="wt" class="simple mc">
        <tr class="hd"><th style="min-width:210px">Mặt hàng</th><th class="r">Số cân được (kg)</th><th class="r dx">Trừ sọt, xe (kg)</th><th class="r dx">Trừ trái hư, dập (kg)</th><th class="r">Khối lượng tính tiền (kg)</th>{money && <><th class="r">Đơn giá (đ/kg)</th><th class="r">Thành tiền</th></>}<th></th></tr>
        {Array.from({ length: N }, (_, i) => (
          <tr class="ln dr"><td class="full"><select name={`item${i}`}>{items.map((it) => <option value={it.id} data-price={it.price} selected={v(`item${i}`) === it.id}>{it.name}</option>)}</select></td>
            <td data-l="Số cân được (kg)"><input class="r gross" data-key name={`gross${i}`} inputmode="decimal" placeholder="số trên bàn cân" value={v(`gross${i}`)} /></td>
            <td class="dx" data-l="Trừ sọt, xe (kg)"><input class="r tare" name={`tare${i}`} inputmode="decimal" value={v(`tare${i}`)} /></td>
            <td class="dx" data-l="Trừ trái hư, dập (kg)"><input class="r ded" name={`ded${i}`} inputmode="decimal" value={v(`ded${i}`)} /></td>
            <td class="r b net" data-l="Khối lượng tính tiền (kg)">0</td>
            {money && <><td data-l="Đơn giá (đ/kg)"><input class="r price auto" name={`price${i}`} inputmode="numeric" value={v(`price${i}`)} /></td><td class="r amt" data-l="Thành tiền (đ)">0</td></>}<td class="dc"><button type="button" class="dr-del" title="Xóa dòng này" aria-label="Xóa dòng">✕</button></td></tr>
        ))}
        <tfoot><tr><td class="full">Cộng cả phiếu</td><td></td><td class="dx"></td><td class="dx"></td><td class="r" id="tnet" data-l="Khối lượng tính tiền (kg)">0</td>{money && <><td></td><td class="r" id="tamt" data-l="Thành tiền (đ)">0</td></>}<td></td></tr></tfoot>
      </table></div><button type="button" class="btn sec sm" data-add style="margin-top:8px">+ Thêm dòng cân</button></div>
      <h3 style="margin-top:14px">Chứng từ đã nhận</h3>
      <div class="row">
        <label class="chk" data-for="trader"><input type="checkbox" name="doc_invoice" checked={!!v('doc_invoice')} /> Hóa đơn của người bán</label>
        <label class="chk" data-for="linked unlinked"><input type="checkbox" name="doc_list" checked={!!v('doc_list')} /> Bảng kê thu mua</label>
        <label class="chk" data-for="linked own"><input type="checkbox" name="doc_contract" checked={!!v('doc_contract')} /> <span id="ctl">Hợp đồng liên kết</span></label>
      </div>
      <div class="f" style="margin-top:12px"><label>Ghi chú</label><input name="note" value={v('note')} /></div>
      <button class="btn">Lưu phiếu cân</button> <a class="btn sec" href="/app/can">Thôi</a>
    </div>
  </form>
  <script is:inline>
  (function(){
    const num=s=>{s=String(s||'').trim().replace(/\s/g,'');if(!s)return 0;if(s.includes(','))s=s.replace(/\./g,'').replace(',','.');const n=Number(s);return isFinite(n)?n:0};
    const fmt=n=>new Intl.NumberFormat('vi-VN',{maximumFractionDigits:1}).format(n);
    const SRC={trader:'Thương lái, vựa: cần hóa đơn của người bán.',linked:'Vườn liên kết: cần hợp đồng liên kết và bảng kê thu mua.',unlinked:'Vườn không liên kết: cần bảng kê thu mua.',own:'Vườn công ty: cần phiếu nhập nội bộ, không phát sinh thanh toán.'};
    const rows=[...document.querySelectorAll('tr.ln')];
    function calc(){let tn=0,ta=0;rows.forEach(r=>{const q=c=>r.querySelector(c);const net=num(q('.gross').value)-num(q('.tare').value)-num(q('.ded').value);
      q('.net').textContent=fmt(net);tn+=net;const p=q('.price');if(p){const a=Math.round(net*num(p.value));q('.amt').textContent=fmt(a);ta+=a}});
      document.getElementById('tnet').textContent=fmt(tn);const t=document.getElementById('tamt');if(t)t.textContent=fmt(ta)}
    rows.forEach(r=>{const s=r.querySelector('select'),p=r.querySelector('.price');
      const fill=()=>{if(p&&!p.dataset.touched)p.value=s.selectedOptions[0].dataset.price||''};
      if(p){if(!p.value)fill();p.addEventListener('input',()=>p.dataset.touched=1)}
      s.addEventListener('change',()=>{fill();calc()})});
    document.getElementById('fm').addEventListener('input',calc);
    const ps=document.getElementById('partner');
    function src(){const o=ps.selectedOptions[0],sub=o&&o.dataset.sub,box=document.getElementById('src');
      document.querySelectorAll('label[data-for]').forEach(l=>l.style.display=!sub||l.dataset.for.split(' ').includes(sub)?'':'none');
      document.getElementById('ctl').textContent=sub==='own'?'Phiếu nhập nội bộ':'Hợp đồng liên kết';
      document.getElementById('payf').style.display=sub==='own'?'none':'';
      if(!sub){box.style.display='none';return}
      box.style.display='';box.className='note '+(o.dataset.area?'info':'warn');
      box.textContent=SRC[sub]+' '+(o.dataset.area?'Mã vùng trồng '+o.dataset.area+' sẽ gắn vào lô.':'Nhà cung cấp này chưa có mã vùng trồng: lô sẽ không được đưa vào đơn xuất khẩu.')}
    const dx=document.getElementById('dxon'),wt=document.getElementById('wt'),hp=document.getElementById('dxhelp');
    function tog(){wt.classList.toggle('simple',!dx.checked);hp.textContent=dx.checked?'Khối lượng tính tiền = số cân được − trọng lượng sọt, xe − phần trái hư dập hai bên thống nhất trừ. Ví dụ cân được 1.000 kg, sọt nặng 20 kg, trừ 5 kg trái dập thì tính tiền 975 kg.':'Gõ số kg trên bàn cân là đủ. Chỉ đánh dấu ô trên khi cân cả sọt, cả xe hoặc có thỏa thuận trừ trái hư dập.';
      if(!dx.checked){document.querySelectorAll('.tare,.ded').forEach(i=>i.value='');calc()}}
    dx.checked=[...document.querySelectorAll('.tare,.ded')].some(i=>num(i.value)>0);dx.addEventListener('change',tog);
    ps.addEventListener('change',src);src();tog();calc();
  })();
  </script>
  <script is:inline src="/rows.js"></script>
</App>
