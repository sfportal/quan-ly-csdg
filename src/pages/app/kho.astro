---
import App from '../../layouts/App.astro';
import { all, run, audit } from '../../lib/db';
import { KIND, STAGE, kg, dong, dmy, perKg } from '../../lib/fmt';
const { tenant: t, user, can } = Astro.locals;
const money = can('money');
if (Astro.request.method === 'POST' && (can('lab') || can('members'))) {
  const f = await Astro.request.formData();
  const st = f.get('act') === 'hold' ? 'hold' : 'ok';
  await run(`UPDATE lots SET status=? WHERE id=? AND tenant_id=?`, st, String(f.get('id')), t.id);
  await audit(t.id, user.id, 'lot.' + st, String(f.get('code') || ''));
  return Astro.redirect('/app/kho' + Astro.url.search);
}
const showAll = Astro.url.searchParams.get('all') === '1';
const lots = await all<any>(
  `SELECT l.*, i.name item, i.kind, i.box_g, p.name partner FROM lots l JOIN items i ON i.id=l.item_id LEFT JOIN partners p ON p.id=l.partner_id
   WHERE l.tenant_id=? AND (l.qty_g>0 OR ?=1) ORDER BY CASE i.kind WHEN 'TP' THEN 0 WHEN 'BTP' THEN 1 WHEN 'NL' THEN 2 ELSE 3 END, l.date DESC, l.code DESC LIMIT 400`, t.id, showAll ? 1 : 0);
const val = (l: any) => Math.round(l.cost_total * l.qty_g / l.qty_in_g);
const groups = ['TP', 'BTP', 'NL', 'PP'].map((k) => ({ k, rows: lots.filter((l) => l.kind === k) }));
const tot = (rows: any[]) => rows.reduce((a, l) => ({ g: a.g + l.qty_g, v: a.v + val(l) }), { g: 0, v: 0 });
const today = new Date().toISOString().slice(0, 10);
const age = (d: string) => Math.max(0, Math.round((Date.parse(today) - Date.parse(d)) / 864e5));
---
<App title="Tồn kho" active="/app/kho">
  <div class="head"><div><h1>Tồn kho theo lô</h1><div class="mut sm">Tồn tính tự động từ phiếu cân, lệnh công đoạn và đơn đã xuất</div></div>
    <a class="btn sec sm" href={showAll ? '/app/kho' : '/app/kho?all=1'}>{showAll ? 'Chỉ lô còn tồn' : 'Hiện cả lô đã hết'}</a></div>
  <div class="grid g4" style="margin-bottom:16px">
    {groups.map((g) => { const s = tot(g.rows); return <div class="kpi"><div class="l">{KIND[g.k]}</div><div class="v">{kg(s.g)} kg</div>{money && <div class="s">giá trị {dong(s.v)} đ</div>}</div>; })}
  </div>
  {groups.filter((g) => g.rows.length).map((g) => (
    <div class="card"><h2>{KIND[g.k]}</h2><div class="tw"><table>
      <tr><th>Lô</th><th>Mặt hàng</th><th>Công đoạn</th><th>Ngày</th><th>Nguồn, vùng trồng</th><th class="r">Thùng</th><th class="r">Tồn (kg)</th>{money && <><th class="r">Giá thành đ/kg</th><th class="r">Giá trị tồn</th></>}<th>Trạng thái</th></tr>
      {g.rows.map((l) => (
        <tr style={l.qty_g ? '' : 'opacity:.5'}><td><a class="b" href={`/app/truy-xuat?lot=${l.id}`}>{l.code}</a></td><td>{l.item}</td><td>{STAGE[l.stage]}</td>
          <td class="nw">{dmy(l.date)}<div class="sm mut">{age(l.date)} ngày</div></td>
          <td class="sm">{l.partner || 'Nhiều nguồn'}<div class={l.area_code ? 'mut' : 'neg'}>{l.area_code || 'chưa có mã vùng trồng'}</div></td>
          <td class="r">{l.boxes || ''}</td><td class="r b">{kg(l.qty_g)}<div class="sm mut" style="font-weight:400">/ {kg(l.qty_in_g)}</div></td>
          {money && <><td class="r">{dong(perKg(l.cost_total, l.qty_in_g))}</td><td class="r">{dong(val(l))}</td></>}
          <td>{l.status === 'hold' ? <span class="tag miss">Đang giữ</span> : <span class="tag ok">Dùng được</span>}
            {(can('lab') || can('members')) && l.qty_g > 0 && <form method="post" style="display:inline"><input type="hidden" name="id" value={l.id} /><input type="hidden" name="code" value={l.code} />
              <button class="btn sec sm" name="act" value={l.status === 'hold' ? 'release' : 'hold'} style="margin-left:6px">{l.status === 'hold' ? 'Bỏ giữ' : 'Giữ lô'}</button></form>}</td></tr>
      ))}
    </table></div></div>
  ))}
  {!lots.length && <div class="card mut">Kho đang trống.</div>}
</App>
