---
import App from '../../../layouts/App.astro';
import { all } from '../../../lib/db';
import { CUST, kg, dong, dmy } from '../../../lib/fmt';
const { tenant: t, can } = Astro.locals;
const money = can('money');
const ty = Astro.url.searchParams.get('t') || '';
const list = await all<any>(
  `SELECT o.*, p.name customer, (SELECT SUM(qty_g) FROM order_lines l WHERE l.order_id=o.id) g, (SELECT SUM(boxes) FROM order_lines l WHERE l.order_id=o.id) boxes
   FROM orders o JOIN partners p ON p.id=o.customer_id WHERE o.tenant_id=? AND (?='' OR o.type=?) ORDER BY o.date DESC, o.code DESC LIMIT 200`, t.id, ty, ty);
const LB = { ok: 'ok', wait: 'wait', fail: 'miss', na: '' };
---
<App title="Đơn hàng" active="/app/don-hang">
  <div class="head"><div><h1>Đơn hàng</h1><div class="mut sm">Đơn lẻ, đơn sỉ trong nước và đơn xuất khẩu</div></div>
    {can('order') && <a class="btn" href="/app/don-hang/moi">Lập đơn hàng</a>}</div>
  <div class="tabs"><a href="/app/don-hang" class={!ty ? 'on' : ''}>Tất cả</a>{Object.entries(CUST).map(([k, v]) => <a href={`?t=${k}`} class={ty === k ? 'on' : ''}>{v}</a>)}</div>
  <div class="card"><div class="tw"><table>
    <tr><th>Số đơn</th><th>Ngày</th><th>Khách hàng</th><th>Kênh</th><th class="r">Thùng</th><th class="r">Kg</th>{money && <><th class="r">Doanh thu</th><th class="r">Lãi gộp</th><th class="r">Còn phải thu</th></>}<th>Kiểm nghiệm</th><th>Trạng thái</th></tr>
    {list.map((o) => { const net = o.revenue - o.deduct, pf = net - o.cogs - o.trip_cost; return (
      <tr><td><a class="b" href={`/app/don-hang/${o.id}`}>{o.code}</a></td><td>{dmy(o.date)}</td><td>{o.customer}<div class="sm mut">{o.container || o.vehicle}</div></td><td>{CUST[o.type]}</td>
        <td class="r">{o.boxes || ''}</td><td class="r">{kg(o.g)}</td>
        {money && <><td class="r">{dong(o.revenue)}</td><td class={`r ${o.status === 'shipped' ? (pf < 0 ? 'neg' : 'pos') : 'mut'}`}>{o.status === 'shipped' ? dong(pf) : ''}</td><td class="r">{o.status === 'shipped' ? dong(net - o.paid) : ''}</td></>}
        <td>{o.type === 'export' ? <><span class={`tag ${LB[o.lab_cd]}`}>Cd</span> <span class={`tag ${LB[o.lab_o]}`}>Vàng O</span></> : ''}</td>
        <td><span class={`tag ${o.status === 'shipped' ? 'ok' : 'wait'}`}>{o.status === 'shipped' ? 'Đã xuất' : 'Chờ xuất'}</span></td></tr>); })}
    {!list.length && <tr><td colspan="11" class="mut">Chưa có đơn hàng nào.</td></tr>}
  </table></div></div>
</App>
